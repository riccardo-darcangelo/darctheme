{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "44rem",
			"wideSize": "80rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customDuotone": false,
			"link": true,
			"heading": true,
			"button": true,
			"caption": true,
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "surface",
					"color": "#f4f5f7",
					"name": "Surface"
				},
				{
					"slug": "surface-strong",
					"color": "#e6e9ed",
					"name": "Surface strong"
				},
				{
					"slug": "contrast",
					"color": "#16191d",
					"name": "Contrast"
				},
				{
					"slug": "contrast-soft",
					"color": "#5b6672",
					"name": "Contrast soft"
				},
				{
					"slug": "primary",
					"color": "#2a3a47",
					"name": "Primary"
				},
				{
					"slug": "primary-strong",
					"color": "#1a252e",
					"name": "Primary strong"
				},
				{
					"slug": "accent",
					"color": "#c2410c",
					"name": "Accent"
				},
				{
					"slug": "accent-soft",
					"color": "#fdf1e9",
					"name": "Accent soft"
				},
				{
					"slug": "border",
					"color": "#dbe0e6",
					"name": "Border"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-contrast",
					"gradient": "linear-gradient(135deg, #2a3a47 0%, #16191d 100%)",
					"name": "Primary to contrast"
				},
				{
					"slug": "surface-fade",
					"gradient": "linear-gradient(180deg, #f4f5f7 0%, #ffffff 100%)",
					"name": "Surface fade"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"customFontSize": true,
			"dropCap": false,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"letterSpacing": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\""
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Cambria, Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "X Small",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "X Large",
					"size": "1.875rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.125rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X Large",
					"size": "2.5rem",
					"fluid": {
						"min": "1.875rem",
						"max": "3rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "3.5rem",
					"fluid": {
						"min": "2.25rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "1",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "2",
					"size": "1rem"
				},
				{
					"slug": "30",
					"name": "3",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "4",
					"size": "clamp(2rem, 4vw, 3rem)"
				},
				{
					"slug": "50",
					"name": "5",
					"size": "clamp(3rem, 6vw, 4.5rem)"
				},
				{
					"slug": "60",
					"name": "6",
					"size": "clamp(4rem, 9vw, 7rem)"
				},
				{
					"slug": "70",
					"name": "7",
					"size": "clamp(5rem, 12vw, 10rem)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "sm",
					"name": "Small",
					"shadow": "0 1px 2px rgba(22, 25, 29, 0.06)"
				},
				{
					"slug": "md",
					"name": "Medium",
					"shadow": "0 2px 4px rgba(22, 25, 29, 0.06), 0 8px 16px rgba(22, 25, 29, 0.06)"
				},
				{
					"slug": "lg",
					"name": "Large",
					"shadow": "0 4px 8px rgba(22, 25, 29, 0.05), 0 16px 32px rgba(22, 25, 29, 0.09)"
				}
			]
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"custom": {
			"radius": {
				"sm": "0.25rem",
				"md": "0.5rem",
				"lg": "1rem",
				"pill": "999px"
			},
			"transition": {
				"fast": "120ms",
				"base": "220ms",
				"slow": "420ms",
				"easing": "cubic-bezier(0.2, 0, 0, 1)"
			},
			"focus": {
				"width": "2px",
				"offset": "2px"
			},
			"header": {
				"height": "4.5rem"
			},
			"measure": "68ch"
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"letterSpacing": "0"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast-soft)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "0.01em",
					"textDecoration": "none"
				},
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--primary-strong)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "1rem",
						"right": "1rem"
					}
				}
			},
			"core/preformatted": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "header-centred",
			"title": "Header, centred",
			"area": "header"
		},
		{
			"name": "header-minimal",
			"title": "Header, minimal",
			"area": "header"
		},
		{
			"name": "header-announcement",
			"title": "Header with announcement bar",
			"area": "header"
		},
		{
			"name": "header-store",
			"title": "Header with shop details",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "footer-compact",
			"title": "Footer, compact",
			"area": "footer"
		},
		{
			"name": "footer-cta",
			"title": "Footer with call to action",
			"area": "footer"
		},
		{
			"name": "footer-contact",
			"title": "Footer with contact details",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-wide",
			"title": "Full width",
			"postTypes": [
				"page",
				"post"
			]
		}
	]
}
