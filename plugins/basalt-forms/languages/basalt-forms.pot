#. Plugin Name of the plugin
#: basalt-forms.php
msgid "Basalt Forms"
msgstr ""

#. Description of the plugin
#: basalt-forms.php
msgid "One accessible form block for contact and appointment requests. Server side validation with the error at the field, a honeypot, a rate limit, delivery by email and a copy of every submission in the admin. No JavaScript, no external service, nothing to configure before it works."
msgstr ""

