#: blocks/maintenance-text/editor.js:54
msgid "Heading 3"
msgstr "Überschrift 3"

#: blocks/maintenance-text/editor.js:63
msgid "Text before"
msgstr "Text davor"

#: blocks/maintenance-text/editor.js:64
msgid "Optional, for example \"back at \"."
msgstr "Optional, zum Beispiel \"zurück um \"."

#: blocks/maintenance-text/editor.js:73
msgid "Text after"
msgstr "Text danach"

#: blocks/maintenance-text/editor.js:82
