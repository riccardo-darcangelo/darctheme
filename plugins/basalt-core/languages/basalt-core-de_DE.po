msgstr "geöffnet"

#: blocks/opening-hours/block.json
msgctxt "block keyword"
msgid "closed"
msgstr "geschlossen"

#: blocks/opening-hours/block.json
msgctxt "block keyword"
msgid "business hours"
msgstr "Geschäftszeiten"

#: blocks/opening-hours/block.json
msgctxt "block keyword"
msgid "shop"
msgstr "Laden"
