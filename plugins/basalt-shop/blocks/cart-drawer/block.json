{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "basalt/cart-drawer",
	"title": "Cart drawer",
	"category": "woocommerce",
	"icon": "cart",
	"description": "The cart as a panel that slides in from the side, rendered on the server. Opens and closes without JavaScript, and opens by itself after something has been added.",
	"keywords": [ "cart", "mini cart", "basket", "drawer" ],
	"textdomain": "basalt-shop",
	"editorScript": "file:./editor.js",
	"supports": {
		"html": false,
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true },
		"color": { "text": true, "background": false }
	},
	"attributes": {
		"label": { "type": "string", "default": "Cart" },
		"showCount": { "type": "boolean", "default": true },
		"showTotal": { "type": "boolean", "default": false }
	}
}
