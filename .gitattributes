# Line endings are normalised to LF in the repository and on checkout.
# core.autocrlf would otherwise hand out CRLF working copies on Windows, which
# contradicts .editorconfig and would put CRLF into the distributed ZIP, since
# the packaging script reads straight from the working tree.
* text=auto eol=lf

# The pre-2.0 theme is kept as a reference. Leave its bytes exactly as they
# were committed rather than rewriting every file for a folder nobody edits.
legacy/** -text

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary

# Not part of the product; keep them out of GitHub's language statistics and
# out of release archives generated by GitHub.
legacy/** linguist-vendored
docs/** linguist-documentation
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/legacy export-ignore
